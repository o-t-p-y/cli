{
  "name": "@o-t-p-y/sdk",
  "version": "0.3.2",
  "description": "OTPy.ir TypeScript SDK — send and verify login OTPs in seconds.",
  "repository": {
    "type": "git",
    "url": "https://github.com/o-t-p-y/cli.git",
    "directory": "packages/otpy"
  },
  "homepage": "https://otpy.ir",
  "bugs": "https://github.com/o-t-p-y/cli/issues",
  "keywords": [
    "otp",
    "otpy",
    "sms",
    "iranian-otp",
    "typescript",
    "iran"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
