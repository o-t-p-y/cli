{
  "name": "otpy-cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "npx otpy init — one-command OTPy integration (framework detection, code patching, PR creation, AI mode). Published as `otpy` in P4.",
  "bin": {
    "otpy": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
